# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env é ignorado pelo git (nunca commite segredos reais).

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# PostgreSQL (compartilhado entre todos os bancos)
POSTGRES_USER=fcgadmin
POSTGRES_PASSWORD=<senha-aqui>

# MongoDB
MONGODB_CONNECTION_STRING=mongodb://mongoDb:27017
MONGODB_DATABASE_NAME=fcg_catalog

# fcg-users — chave privada RSA 2048 (PKCS#8, DER) em base64. Para gerar uma nova:
#   Linux / macOS / WSL / Git Bash: openssl genrsa 2048 2>/dev/null | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w 0; echo
#   colocar valor entre aspas: JWT_PRIVATE_KEY_BASE64="<sua-chave-aqui>"
JWT_PRIVATE_KEY_BASE64=<sua-chave-aqui>

# GitHub Packages — token com permissão read:packages para restaurar os pacotes NuGet do fcg-shared
# Gerar em: https://github.com/settings/tokens → New token → read:packages
NUGET_AUTH_TOKEN="<seu-token-github>"
